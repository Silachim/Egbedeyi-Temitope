{
  "name": "egbedeyi-temitope-react",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "blog:new": "node scripts/create-blog-post.mjs",
    "blog:validate": "node scripts/validate-blog-content.mjs",
    "dev": "npm run blog:validate && vite",
    "build": "npm run blog:validate && vite build && node scripts/generate-discovery-pages.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
